# Supabase project settings (server-only values; never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Official domain SMTP. Use a mailbox password / app password from the mail provider.
SMTP_HOST=smtps.udag.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=server@digital-future.ai
SMTP_PASSWORD=SET_IN_HOST_SECRET_MANAGER
SMTP_FROM=Helpmey <server@digital-future.ai>
CONTACT_EMAIL=contact@digital-future.ai
INFO_EMAIL=info@digital-future.ai
SERVER_EMAIL=server@digital-future.ai

# Optional sender identities (each address must be provisioned/authorized by provider)
CONTACT_FROM=Helpmey Support <contact@digital-future.ai>
INFO_FROM=Helpmey <info@digital-future.ai>

# Public URL of this deployed backend, used for auth redirect allow-list
APP_ORIGIN=https://YOUR_BACKEND_DOMAIN
