# Copy to .env.local locally or configure in the hosting provider's secret manager.
# Never commit .env.local or real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IF_SERVER_ADMIN_TASKS_REQUIRE_IT

# Optional direct PostgreSQL connections. Rotate any password that has been shared.
# Encode reserved characters in the password as URL percent-encoding.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Official domain SMTP; set the real mailbox password in encrypted host secrets only.
SMTP_HOST=smtps.udag.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=server@digital-future.ai
SMTP_PASS=SET_IN_HOST_SECRET_MANAGER
SMTP_PASSWORD=SET_IN_HOST_SECRET_MANAGER
SMTP_FROM=Helpmey <server@digital-future.ai>
CONTACT_EMAIL=contact@digital-future.ai
INFO_EMAIL=info@digital-future.ai
SERVER_EMAIL=server@digital-future.ai
SMTP_TEST_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
SUPPLIER_SYNC_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

APP_ORIGIN=https://YOUR_DEPLOYED_BACKEND_DOMAIN
NEXT_PUBLIC_SITE_URL=https://YOUR_DEPLOYED_BACKEND_DOMAIN

# Security and anti-abuse (required in production)
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=SET_IN_HOST_SECRET_MANAGER
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=SET_BASE64_32_BYTE_KEY_IN_HOST_SECRET_MANAGER

# Stripe payment integration
STRIPE_SECRET_KEY=SET_IN_HOST_SECRET_MANAGER
STRIPE_WEBHOOK_SECRET=SET_IN_HOST_SECRET_MANAGER

# PayPal webhook verification (optional until PayPal is activated)
PAYPAL_CLIENT_ID=SET_IN_HOST_SECRET_MANAGER
PAYPAL_CLIENT_SECRET=SET_IN_HOST_SECRET_MANAGER
PAYPAL_WEBHOOK_ID=SET_IN_HOST_SECRET_MANAGER
PAYPAL_API_BASE=https://api-m.paypal.com

# Klarna HMAC-SHA256 signing key map (optional until Klarna is activated)
KLARNA_WEBHOOK_SIGNING_KEYS={"key-id-from-klarna":"secret-signing-key"}
