# Copy to .env.local locally or configure in the hosting provider's secret manager.
# Never commit .env.local or real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IF_SERVER_ADMIN_TASKS_REQUIRE_IT

# Optional direct PostgreSQL connections. Rotate any password that has been shared.
# Encode reserved characters in the password as URL percent-encoding.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Official domain SMTP; set the real mailbox password in encrypted host secrets only.
SMTP_HOST=smtps.udag.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@digital-future.ai
SMTP_PASS=SET_IN_HOST_SECRET_MANAGER
SMTP_PASSWORD=SET_IN_HOST_SECRET_MANAGER
SMTP_FROM=Helpmey <contact@digital-future.ai>
CONTACT_EMAIL=contact@digital-future.ai
INFO_EMAIL=info@digital-future.ai
SERVER_EMAIL=server@digital-future.ai
SMTP_TEST_TOKEN=GENERATE_A_LONG_RANDOM_SECRET\nSUPPLIER_SYNC_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

APP_ORIGIN=https://YOUR_DEPLOYED_BACKEND_DOMAIN
NEXT_PUBLIC_SITE_URL=https://YOUR_DEPLOYED_BACKEND_DOMAIN
